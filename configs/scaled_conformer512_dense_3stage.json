{
  "run_name": "scaled-conformer512-dense-3stage",
  "description": "Dense Conformer-Medium MoE-Free Baseline (d_model=512, 12 layers, ffn_expansion=8, 130.8M params), 30k pretraining steps, pooled RESPIN adaptation, and multi-source calibration (Total parameter-matched to 130.8M MoE)",
  "start_stage": 1,
